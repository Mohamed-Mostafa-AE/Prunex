# Leave both Supabase values blank to use the local IndexedDB archive only.
# Every VITE_* value is public browser configuration. Never place a service-role
# key, Turnstile secret, or other server credential in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional anti-bot protection for the one-time Supabase guest-account creation
# request only. It does not add a challenge to browsing or normal chess gameplay.
# Leave both values unset/false to run without any CAPTCHA/Turnstile widget.
VITE_TURNSTILE_SITE_KEY=
VITE_REQUIRE_GUEST_TURNSTILE=false

# Server-only variables for the private archive API. Never prefix these with VITE_.
# NEON_DATABASE_URL is the least-privilege pooled role connection string.
NEON_DATABASE_URL=
# Only this verified Supabase Auth email can access the cloud archive.
PRUNEX_OWNER_EMAIL=

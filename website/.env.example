# Leave blank to use the local IndexedDB archive only.
# Every VITE_* value is included in the public browser bundle. Never place
# service-role keys, provider secrets, or private credentials in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public Cloudflare Turnstile site key. The matching secret belongs in
# Supabase Auth > Bot and Abuse Protection > CAPTCHA, never in the browser.
VITE_TURNSTILE_SITE_KEY=

# Local development may leave this false. Production must be true after
# the Turnstile site key and Supabase CAPTCHA secret have been configured.
VITE_REQUIRE_CAPTCHA=false
